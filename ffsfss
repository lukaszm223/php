<h2>9. Produkty w koszyku użytkownika</h2>
<?php
$sql = "SELECT p.nazwa, p.cena, p.kategoria 
        FROM koszyk k 
        JOIN produkty p ON k.id_produktu = p.id 
        WHERE k.id_uzytkownika = 1";
$wynik = mysqli_query($polaczenie, $sql);

echo "<table border='1' cellpadding='5'>";
echo "<tr><th>Nazwa</th><th>Cena</th><th>Kategoria</th></tr>";
while($w = mysqli_fetch_assoc($wynik)) {
    echo "<tr><td>".$w['nazwa']."</td><td>".$w['cena']."</td><td>".$w['kategoria']."</td></tr>";
}
echo "</table>";
?>

